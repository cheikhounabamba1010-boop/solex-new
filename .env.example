# --- Supabase (obligatoire en production) ---
# Supabase -> Project Settings -> API
SUPABASE_URL="https://xxxxxxxx.supabase.co"
# Clé "service_role" (SECRÈTE : ne jamais la mettre dans le front ni sur GitHub)
SUPABASE_SERVICE_ROLE_KEY="eyJ..."
# Nom du bucket d'images (créé par supabase-setup.sql)
SUPABASE_BUCKET="uploads"

# --- Mot de passe admin initial (utilisé seulement à la 1re initialisation de la base) ---
ADMIN_PASSWORD="choisissez-un-mot-de-passe-solide"

# Facultatif
# PORT=3000
